usage() {
  cat <<EOF
goku — run a local AWS cloud on your machine (formerly Mimir; the mimir command still works but is deprecated)

Usage: goku <command> [options]        goku help <command> for details

Lifecycle (Docker)
  start            Start Goku (downloads on first run) and open the console
  stop             Stop Goku — state is saved automatically
  restart          Restart Goku
  status           Show what's running
  logs [-f]        Container logs; --lambda <fn> [--follow] for a function's CloudWatch logs
  update           Update to the newest version (resources are preserved)
  doctor           Check your environment and the backend's features
  uninstall        Remove Goku ('--purge' also deletes saved state)
  version          Print versions

Working with a running Goku
  open [svc [res]] Open the console (a service page, a bucket, a table or a function)
  env              Print AWS_ENDPOINT_URL etc. for eval "\$(goku env)"
  services         List, subscribe or unsubscribe services (and presets)
  ready            Wait until services are ready (CI) — exit 0 when ready
  snapshot         Save, restore, list, export, import, delete or reset the whole local cloud
  chaos            Fault injection: presets, stop, panic button, events
  iam              Enforcement mode, access-denied log, generate-policy, IAM Lab tests
  lambda debug     Step-through debugging of a Lambda function from your IDE

Global options: --json  --endpoint URL  --console-url URL  --region R  --no-color
Exit codes: 0 ok · 1 failed / not ready / test failures · 2 usage · 3 Goku unreachable · 4 Goku too old

Console: $CONSOLE_URL · AWS endpoint: $ENDPOINT
Docs: https://tanuj24.github.io/goku/
EOF
}

help_cmd() {
  case "$1" in
    start) cat <<'EOF'
goku start [--no-open]
  Starts the Goku container (pulling the image on first run), waits until it is healthy and
  opens the console. State is kept in the mimir-data volume. The Docker socket and /tmp/goku-glue
  (the work folder of Glue jobs) are mounted into it. Mimir is now Goku: a container named mimir
  from before (with no goku container) is renamed goku, and one on the image's former name,
  tanujsoni027/mimir-aws, starts as it is until 'goku update' moves it to tanujsoni027/goku.
  Env: GOKU_IMAGE (tanujsoni027/goku:latest), GOKU_CONTAINER (goku; when set, nothing is renamed),
       GOKU_CONSOLE_PORT (8080), GOKU_EDGE_PORT (4566),
       GOKU_ENGINE_PORTS (5500-5524, "off" to publish none), GOKU_DATA_VOLUME (mimir-data),
       GOKU_AUTO_PERSIST (off = keep no state), GOKU_NO_BROWSER=1
       (the former MIMIR_* names work too; GOKU_* wins when both are set)
EOF
    ;;
    stop|restart|update|uninstall|doctor|version) cat <<'EOF'
goku stop                   stop the container (state is saved)
goku restart [--no-open]    stop + start
goku update                 pull the newest image and recreate the container (resources kept)
goku uninstall [--purge]    remove the container and its engine containers (--purge: the saved state too)
goku doctor                 check Docker, ports, saved state, curl, the endpoint and its 4.0 features
goku version [--json]       print the CLI version and image
EOF
    ;;
    status) cat <<'EOF'
goku status [--json]
  Container state, backend health (services running, version), endpoint and console URLs.
  Works for a Goku started any other way too (GOKU_ENDPOINT / --endpoint).
  --json exits 3 when the endpoint is not reachable.
EOF
    ;;
    logs) cat <<'EOF'
goku logs [docker logs options]
  The Goku container's logs (e.g. goku logs -f --tail 100).

goku logs --lambda <function> [--follow] [--since 10m] [--filter text] [--json]
goku logs --group <log group> [--follow] [--since 10m] [--filter text] [--json]
  CloudWatch Logs of a Lambda function (/aws/lambda/<function>) or any log group, read through the
  CloudWatch Logs API (FilterLogEvents). Default window: the last hour (5 minutes with --follow).
  --since takes 30s, 10m, 2h, 1d or epoch milliseconds. Times are UTC. --json prints one JSON event
  per line. With --follow the command waits for the group to appear and polls every 2 s.
EOF
    ;;
    open) cat <<'EOF'
goku open [service|page] [resource] [--print]
  Opens the console (GOKU_CONSOLE_URL, default http://localhost:8080).
    goku open                     home
    goku open sqs                 a service page (any console service id)
    goku open s3 my-bucket        a bucket          goku open dynamodb orders    a table
    goku open lambda my-fn        a function
    pages: resources, snapshots, chaos, services, iam-lab, enforcement, denied, generate-policy, iam-tests
  --print only prints the URL (also: GOKU_NO_BROWSER=1).
EOF
    ;;
    env) cat <<'EOF'
goku env [--shell sh|bash|zsh|fish] [--fish] [--unset] [--json]
  Prints the environment that points the AWS CLI and SDKs at Goku:
    eval "$(goku env)"                  bash / zsh / sh
    goku env --fish | source            fish
    eval "$(goku env --unset)"          back to real AWS
  Sets AWS_ENDPOINT_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, AWS_DEFAULT_REGION
  from GOKU_ENDPOINT, GOKU_ACCESS_KEY_ID / GOKU_SECRET_ACCESS_KEY (test/test) and GOKU_REGION.
EOF
    ;;
    services) cat <<'EOF'
goku services [list] [--subscribed|--available] [--json]
goku services presets [--json]
goku services subscribe <id|preset>... [--no-wait]
goku services unsubscribe <id>... [--no-wait]
  Goku runs only the services you subscribe to; unsubscribed services answer SubscriptionRequired.
  Ids are console ids (s3, dynamodb, lambda, rds, states…); presets: core, serverless, data, …
  subscribe/unsubscribe wait until the service is active/stopped unless --no-wait.
EOF
    ;;
    ready) cat <<'EOF'
goku ready [--services s3,sqs,...] [--wait SECONDS] [--subscribe] [--no-engines] [--quiet] [--json]
  Asks Goku whether the services (default: every subscribed one) can be used right now.
  Exit 0 when ready, 1 when not ready (after --wait), 2 for unknown service names, 3 when Goku is
  not reachable. With --wait the command also waits for Goku itself to come up — use it in CI
  right after starting the container:
    goku ready --services s3,dynamodb,sqs --wait 120
  --subscribe subscribes the missing services first; --no-engines skips the Docker check of
  engine-backed services.  Requires Goku 4.0+.
EOF
    ;;
    snapshot) cat <<'EOF'
goku snapshot save <name> [--description d] [--services s3,dynamodb] [--accounts id,...]
                           [--no-engine-data] [--subscriptions] [--overwrite] [--no-wait]
goku snapshot restore <name> [--services s3,sqs] [--subscriptions|--no-subscriptions] [--no-wait]
goku snapshot list
goku snapshot show <name>
goku snapshot export <name> [-o file.tar.gz | -o -]
goku snapshot import <file.tar.gz> [--name n] [--overwrite] [--restore]
goku snapshot delete <name>...
goku snapshot reset [--services s3,sqs] [--accounts id,...] [--yes] [--no-wait]
  Environment snapshots of the whole local cloud (every service and account; RDS dumps and EC2
  filesystems with engine data, on by default). Save/restore/reset show progress and wait.
  reset asks you to type 'reset' unless --yes (required when stdin is not a terminal).
  Requires Goku 4.0+.
EOF
    ;;
    chaos) cat <<'EOF'
goku chaos [status]                         active rules, running experiments, injections
goku chaos list                             one-click presets
goku chaos preset <id> [--minutes N] [--probability 0.2]
goku chaos stop [<experiment id|preset id>] stop one (or every) running experiment
goku chaos panic                            remove every rule and stop every experiment
goku chaos events [--limit N] [--follow] [--rule id] [--experiment id]
  Fault injection: AWS-shaped throttling, errors, latency, timeouts, Lambda cold starts,
  SQS drops/duplicates, DynamoDB conflicts. Calls from the Goku console are never affected.
  Requires Goku 4.0+.
EOF
    ;;
    iam) cat <<'EOF'
goku iam mode [off|audit|enforce] [--principals arn,...|--tag key[=value]|--all] [--reset]
  Shows or sets IAM enforcement. audit logs would-be denials, enforce fails calls with AccessDenied.
  --reset goes back to the configured default.

goku iam denied [--principal arn|name] [--since 1h] [--action 's3:*'] [--mode audit|enforce] [--limit N]
goku iam denied <id>
  The access-denied log (newest first); with an id: why it was denied and the fix to apply.

goku iam generate-policy --principal <arn|name> [--since 2h] [--until ...] [--granularity exact|prefix|service]
                          [--services s3,dynamodb] [--include-read-only] [--no-failed-calls] [-o policy.json]
                          [--save-draft <name>]
  The least-privilege policy for what the principal actually called (CloudTrail capture). The
  policy goes to stdout (or -o file); the evidence summary to stderr.

goku iam test <scenario id|name> [--sync] [--snapshot id] [--connection id] [--strict] [--junit file]
goku iam test --list
  Runs an IAM Lab test scenario against the latest IAM snapshot of this account (LOCAL connection).
  --sync imports the current IAM first (creating the LOCAL connection if needed). Exit 1 when a test
  FAILs or ERRORs (--strict: also INCOMPLETE) — made for CI. --junit writes a JUnit XML report.
  Requires Goku 4.0+.
EOF
    ;;
    lambda) cat <<'EOF'
goku lambda debug <function> [--wait] [--qualifier Q] [--timeout SECONDS] [--language node|python|java|ruby|go]
goku lambda debug <function> --off [--qualifier Q]
goku lambda debug <function> --status | --launch-json
goku lambda debug --list
  Turns on debug mode: the function runs under its language debugger (Node inspector, debugpy,
  JDWP, rdbg, Delve) on a host port, one environment at a time, with a 15-minute timeout.
  Prints the attach address and a ready .vscode/launch.json:
    goku lambda debug orders --wait --launch-json > .vscode/launch.json
  --wait holds every invocation until a debugger is attached. Requires Goku 4.0+.
EOF
    ;;
    exit-codes) cat <<'EOF'
0  success (ready, all tests passed)
1  the operation failed, the API returned an error, not ready, or IAM tests failed
2  usage error (unknown command/option, unknown service name, unconfirmed reset)
3  Goku is not reachable at the endpoint
4  the running Goku is too old for the command (requires Goku 4.0+)
EOF
    ;;
    ""|help) usage ;;
    *) err "no help for '$1'"; usage; exit "$EX_USAGE" ;;
  esac
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

# `mimir`, the command's former name, is installed as a link to goku: it behaves exactly the same, and
# says first on every run, on stderr, that it is deprecated (so `eval "$(mimir env)"`, --json and pipes
# are unaffected). GOKU_NO_DEPRECATION_NOTICE=1 turns the notice off.
case "${0##*/}" in
  [Mm][Ii][Mm][Ii][Rr]|[Mm][Ii][Mm][Ii][Rr].[Ee][Xx][Ee])
    case "${GOKU_NO_DEPRECATION_NOTICE:-}" in
      ""|0|false|FALSE|False|no|NO|No)
        note "note: 'mimir' is deprecated and will be removed in a future release; use 'goku' instead (same commands and options)." ;;
    esac ;;
esac

# Global options may appear anywhere: pull them out, keep the rest in order.
_args=""
while [ $# -gt 0 ]; do
  case "$1" in
    --json) JSON_OUT=true ;;
    --no-color) colors off ;;
    --endpoint|--console-url|--region)
      [ $# -ge 2 ] || { err "option $1 needs a value"; exit "$EX_USAGE"; }
      case "$1" in --endpoint) ENDPOINT=$2 ;; --console-url) CONSOLE_URL=$2 ;; --region) REGION=$2 ;; esac
      shift ;;
    --endpoint=*) ENDPOINT=${1#*=} ;;
    --console-url=*) CONSOLE_URL=${1#*=} ;;
    --region=*) REGION=${1#*=} ;;
    *) _args="$_args $(shq "$1")" ;;
  esac
  shift
done
eval "set -- $_args"
ENDPOINT=$(strip_slash "$ENDPOINT")
$JSON_OUT && colors off

CMD=${1:-}
[ $# -gt 0 ] && shift
case "$CMD" in
  service) CMD=services ;;
  snapshots|snap) CMD=snapshot ;;
  faults) CMD=chaos ;;
esac
case " $* " in
  *" -h "*|*" --help "*) [ "$CMD" != logs ] && { help_cmd "$CMD"; exit 0; } ;;
esac
tmp_init

case "$CMD" in
  start)     cmd_start "$@" ;;
  stop)      cmd_stop "$@" ;;
  restart)   cmd_restart "$@" ;;
  status)    cmd_status "$@" ;;
  logs)      cmd_logs "$@" ;;
  update)    cmd_update "$@" ;;
  open)      cmd_open "$@" ;;
  doctor)    cmd_doctor "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  env)       cmd_env "$@" ;;
  services)  cmd_services "$@" ;;
  ready)     cmd_ready "$@" ;;
  snapshot)  cmd_snapshot "$@" ;;
  chaos)     cmd_chaos "$@" ;;
  iam)       cmd_iam "$@" ;;
  lambda)    cmd_lambda "$@" ;;
  version|-v|--version) cmd_version ;;
  help)      help_cmd "${1:-}" ;;
  ""|-h|--help) usage ;;
  *) err "unknown command: $CMD"; usage >&2; exit "$EX_USAGE" ;;
esac
