# ---------------------------------------------------------------------------

cmd_lambda() {
  _sub=${1:-}; [ $# -gt 0 ] && shift
  case "$_sub" in
    debug) FEATURE="Lambda debugging"; lambda_debug "$@" ;;
    "") usage_die "name a lambda command: debug" ;;
    *) usage_die "unknown lambda command: $_sub" ;;
  esac
}

lambda_debug() {
  _fn=""; _wait=false; _off=false; _qual=""; _tmo=""; _lang=""; _status=false; _launch=false; _list=false
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) _o=${1%%=*}; _v=${1#*=}; shift; set -- "$_o" "$_v" "$@"; continue ;; esac
    case "$1" in
      --wait) _wait=true; shift ;;
      --off) _off=true; shift ;;
      --qualifier|-q) need_val "$@"; _qual=$2; shift 2 ;;
      --timeout) need_val "$@"; is_int "$2" || usage_die "--timeout takes seconds"; _tmo=$2; shift 2 ;;
      --language) need_val "$@"; _lang=$2; shift 2 ;;
      --status) _status=true; shift ;;
      --launch-json) _launch=true; shift ;;
      --list) _list=true; shift ;;
      -*) usage_die "unknown option: $1" ;;
      *) [ -z "$_fn" ] || usage_die "one function at a time"; _fn=$1; shift ;;
    esac
  done
  if $_list; then
    API_SIGN=lambda api GET /_mimir/lambda/debug || api_die "could not list debug sessions"
    if $JSON_OUT; then out_json; return 0; fi
    if [ "$(jcount sessions)" = 0 ]; then say "No function is in debug mode."; return 0; fi
    jrows sessions functionName qualifier language "debugger.port|port" "environment.phase|phase" waitForDebugger:yesno \
        "environment.debuggerAttached|debuggerAttached:yesno" \
      | table "FUNCTION|QUALIFIER|LANGUAGE|PORT|ENVIRONMENT|WAIT|ATTACHED"
    return 0
  fi
  [ -n "$_fn" ] || usage_die "name the function: goku lambda debug <function>"
  _path="/_mimir/lambda/functions/$(urlenc "$_fn")/debug"
  if $_status; then
    API_SIGN=lambda api GET "$_path${_qual:+?qualifier=$(urlenc "$_qual")}" || api_die "could not read debug status of $_fn"
  else
    if $_off; then
      _body="{\"enabled\":false${_qual:+,\"qualifier\":$(jstr "$_qual")}}"
    else
      _body="{\"enabled\":true,\"waitForDebugger\":$_wait${_qual:+,\"qualifier\":$(jstr "$_qual")}${_tmo:+,\"timeoutSeconds\":$_tmo}${_lang:+,\"language\":$(jstr "$_lang")}}"
    fi
    API_SIGN=lambda api PUT "$_path" "$_body" || api_die "could not change debug mode of $_fn"
  fi
  if $JSON_OUT; then out_json; return 0; fi
  if $_launch; then
    [ "$(jget enabled)" = true ] || die "debug mode is off for $_fn — turn it on first: goku lambda debug $_fn"
    jget launchConfigurations.vscodeLaunchJson
    return 0
  fi
  _q=$(jget qualifier)
  if [ "$(jget enabled)" != true ]; then
    say "Debug mode ${C_B}off${C_0} for $_fn ($_q)$( [ "$(jget source)" = tag ] && printf ' — the function tags decide')"
    [ "$(jget supported)" = false ] && say "  not supported: $(jget unsupportedReason)"
    return 0
  fi
  _host=$(jget debugger.host); _port=$(jget debugger.port)
  say "Debug mode ${C_G}ON${C_0} for ${C_B}$_fn${C_0} ($_q) — $(jget language), $(jget debugger.protocol)"
  say "  Attach to:     ${C_B}$_host:$_port${C_0}  (container port $(jget debugger.containerPort), bound on $(jget debugger.bindAddress))"
  _ph=$(jget environment.phase)
  case "$_ph" in NO_ENVIRONMENT) _ph="not started — starts on the next invocation" ;; esac
  say "  Environment:   $_ph$( [ "$(jget environment.debuggerAttached)" = true ] && printf ' · debugger attached')"
  if [ "$(jget waitForDebugger)" = true ]; then
    say "  Wait:          every invocation waits until a debugger is attached"
  else
    say "  Wait:          no — use --wait to hold invocations until you attach"
  fi
  say "  Timeout:       $(jget timeoutSeconds) s while debugging (function: $(jget functionTimeoutSeconds) s)"
  [ -n "$(jget environment.lastError)" ] && say "  Last error:    $(jget environment.lastError)"
  say ""
  say "${C_B}VS Code${C_0} — .vscode/launch.json (or: goku lambda debug $_fn --launch-json > .vscode/launch.json):"
  jget launchConfigurations.vscodeLaunchJson
  _cli=$(jget launchConfigurations.cli)
  [ -n "$_cli" ] && { say ""; say "Command line:  $_cli"; }
  jrows launchConfigurations.notes @key | while IFS= read -r _i; do note "  note: $(jget "launchConfigurations.notes.$_i")"; done
  note ""
  note "turn it off: goku lambda debug $_fn --off${_qual:+ --qualifier $_qual}"
}

# ---------------------------------------------------------------------------
# logs — container logs, or CloudWatch Logs of a Lambda function / log group
# ---------------------------------------------------------------------------

cmd_logs() {
  _group=""; _follow=false; _since=""; _filter=""; _docker=""
  _has_cw=false
  for _a in "$@"; do case "$_a" in --lambda|--lambda=*|--group|--group=*) _has_cw=true ;; esac; done
  if ! $_has_cw; then
    need_docker
    container_exists || die "Goku is not running."
    docker logs "$@" "$NAME"
    return $?
  fi
  FEATURE="CloudWatch Logs"; FEATURE_MIN="4.0"
  while [ $# -gt 0 ]; do
    case "$1" in --*=*) _o=${1%%=*}; _v=${1#*=}; shift; set -- "$_o" "$_v" "$@"; continue ;; esac
    case "$1" in
      --lambda) need_val "$@"; _group="/aws/lambda/$2"; shift 2 ;;
      --group) need_val "$@"; _group=$2; shift 2 ;;
      --follow|-f) _follow=true; shift ;;
      --since) need_val "$@"; _since=$2; shift 2 ;;
      --filter) need_val "$@"; _filter=$2; shift 2 ;;
      *) usage_die "unknown argument: $1" ;;
    esac
  done
  if [ -n "$_since" ]; then _start=$(since_ms "$_since"); elif $_follow; then _start=$(since_ms 5m); else _start=$(since_ms 1h); fi
  _start0=$_start
  _seen=""
  _waited=false
  _printed=0
  _limit=$LOGS_PAGE
  if ! $_follow; then
    # FilterLogEvents answers an empty page for a missing group: say so instead of printing nothing.
    API_SIGN=logs API_TARGET=Logs_20140328.DescribeLogGroups api POST / "{\"logGroupNamePrefix\":$(jstr "$_group")}" \
      || api_die "could not read log groups"
    jrows logGroups logGroupName | grep -qxF -- "$_group" \
      || die "no logs for $_group yet (the log group does not exist — has the function run?)"
  fi
  [ -t 2 ] && $_follow && note "tailing $_group at $ENDPOINT (Ctrl-C to stop)…"
  while :; do
    _body="{\"logGroupName\":$(jstr "$_group"),\"startTime\":$_start,\"limit\":$_limit,\"interleaved\":true${_filter:+,\"filterPattern\":$(jstr "$_filter")}}"
    if ! API_SIGN=logs API_TARGET=Logs_20140328.FilterLogEvents api POST / "$_body"; then
      if [ "$(jfirst __type code)" != "" ] && api_error_text | grep -q ResourceNotFound; then
        if ! $_follow; then die "no logs for $_group yet (the log group does not exist — has the function run?)"; fi
        $_waited || note "waiting for $_group to be created…"; _waited=true
        nap 2; continue
      fi
      api_die "could not read $_group"
    fi
    # print new events, remember the last timestamp and the ids already printed at it
    _res=$(LS_SEEN=$_seen LC_ALL=C awk -F'\t' -v json="$JSON_OUT" "$AWK_LIB"'
      BEGIN { n = split(ENVIRON["LS_SEEN"], s, " "); for (i = 1; i <= n; i++) seen[s[i]] = 1 }
      $1 ~ /^events\.[0-9]+\./ {
        split($1, p, "."); k = p[2]; f = p[3]; v = substr($0, length($1) + 2)
        if (!(k in has)) { has[k] = 1; ord[++m] = k }
        E[k, f] = v
      }
      END {
        last = ""; ids = ""
        for (j = 1; j <= m; j++) {
          k = ord[j]; id = unesc(E[k, "eventId"]); ts = E[k, "timestamp"]
          if (id in seen) continue
          msg = unesc(E[k, "message"]); sub(/\n+$/, "", msg)
          if (json == "true") printf "{\"timestamp\":%s,\"time\":%s,\"logStreamName\":%s,\"eventId\":%s,\"message\":%s}\n", ts, jesc(mstime(ts)), E[k, "logStreamName"], E[k, "eventId"], jesc(msg)
          else printf "%s  %s\n", mstime(ts), msg
          if (ts != last) { last = ts; ids = "" }
          ids = ids " " id
        }
        printf "#STATE %d %s%s\n", m, last, ids
      }' "$TMP/flat")
    _lines=$(printf '%s\n' "$_res" | sed '$d')
    if [ -n "$_lines" ]; then printf '%s\n' "$_lines"; _printed=1; fi
    _state=$(printf '%s\n' "$_res" | sed -n '$p')
    _count=$(printf '%s' "$_state" | cut -d' ' -f2)
    _lt=$(printf '%s' "$_state" | cut -d' ' -f3)
    if [ -n "$_lt" ]; then
      if [ "$_lt" = "$_start" ]; then _seen="$_seen $(printf '%s' "$_state" | cut -d' ' -f4-)"
      else _start=$_lt; _seen=$(printf '%s' "$_state" | cut -d' ' -f4-); fi
    fi
    if [ "${_count:-0}" -ge "$_limit" ]; then
      # a full page: there may be more. Only old events in it (more events in one millisecond
      # than a page holds): ask for a bigger page, then move past that millisecond.
      if [ -z "$_lt" ]; then
        if [ "$_limit" -lt 10000 ]; then _limit=$((_limit * 4)); [ "$_limit" -gt 10000 ] && _limit=10000
        else _start=$((_start + 1)); _seen=""; fi
      fi
      continue
    fi
    _limit=$LOGS_PAGE
    $_follow || break
    nap 2
  done
  [ "$_printed" = 0 ] && ! $JSON_OUT && note "no log events in $_group since $(printf '%s' "$_start0" | awk "$AWK_LIB"'{print mstime($1)}') UTC"
  return 0
}

